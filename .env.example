# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER expose to the client / never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# --- Movie/show data provider (server-only) ---
MOVIE_API_PROVIDER=mock   # mock | tmdb | custom
MOVIE_API_KEY=
MOVIE_API_BASE_URL=

# --- Payment provider (server-only) ---
PAYMENT_PROVIDER=dev_simulator   # dev_simulator (LOCAL ONLY, hard-disabled in production) | phonepe
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=

# --- Phone/OTP verification ---
# No env vars needed here anymore. The "phone verification" step on the Sell
# flow now uses Supabase Auth's built-in email OTP (free, no SMS gateway, no
# custom SMTP required in this app) — see app/api/phone/send-otp/route.ts.
#
# One-time setup in the Supabase dashboard (still free):
#   1. Authentication -> Email Templates -> "Magic Link" -> add {{ .Token }}
#      to the template so the email shows a code.
#   2. Authentication -> Providers -> Email -> "Email OTP Length" -> set to 6.
#      IMPORTANT: some Supabase projects default this to 8. This app's OTP
#      box UI and validation are both fixed at 6 digits, so if this setting
#      is left higher, the emailed code will never fit the form and every
#      code will look "incorrect". This is the #1 cause of OTP failures.
#   3. (Recommended for production) Authentication -> Emails -> SMTP Settings
#      -> connect a free-tier SMTP sender (e.g. Brevo, 300 emails/day, free)
#      so mail doesn't rely on Supabase's shared, low-volume default mailer.
#   4. Authentication -> Providers -> Email -> tune "OTP expiry" (default 1hr)
#      and rate limits to taste.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=development

# --- Movie suggestions ---
OMDB_API_KEY=      # IMDb ratings via omdbapi.com
TMDB_API_KEY=      # optional: OTT platforms (themoviedb.org watch providers)
CRON_SECRET=   # long random string; protects /api/cron/sync-events

# ============================================================================
# PRODUCTION / SEO  (added in the production rebuild)
# ============================================================================
# Public https URL of the site, no trailing slash. Used for canonical URLs, sitemap, Open Graph and
# structured data. It is INLINED AT BUILD TIME, so set it in the build environment too.
#   NEXT_PUBLIC_APP_URL=https://www.your-domain.com
# Must be "production" on the live site, otherwise robots.txt blocks all crawlers (safe for staging).
#   APP_ENV=production
# Shown on /contact and in Organization structured data.
NEXT_PUBLIC_SUPPORT_EMAIL=
# Secret for /api/cron/sync-events (Authorization: Bearer $CRON_SECRET).
CRON_SECRET=
# Search-engine ownership verification tokens (Search Console / Bing Webmaster Tools).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Content-Security-Policy ships report-only; set to true after checking the browser console.
CSP_ENFORCE=false

# ============================================================================
# PHONEPE PAYMENT GATEWAY (set PAYMENT_PROVIDER=phonepe to turn it on)
# ============================================================================
PHONEPE_ENV=sandbox                # sandbox | production
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
# Webhook (PhonePe Business Dashboard -> Developer Settings -> Webhook, auth type SHA). Same username/password here.
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=
